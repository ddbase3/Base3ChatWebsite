{
	"nodes": [
		{ "id": "assistant", "type": "streamingaiassistantnode", "docks": {
			"chatmodel": [ "llm" ],
			"memory": [ "timememory", "sessionmemory" ],
			"tools": [
				"retrieval", "telegram", "weather", "currency", "system", "webfetch",
				"helloworld", "photomosaicdemo", "canvasclose",
				"datahawk", "vizion"
			],
			"logger": [],
			"profileselector": [ "profiles" ]
		}}
	],
	"resources": [
		{ "id": "llm", "type": "openaichatmodelagentresource", "config": {
			"apikey": { "mode": "config", "section": "openai", "key": "apikey" },
			"model": { "mode": "fixed", "value": "gpt-4o-mini" },
			"temperature": { "mode": "fixed", "value": 0.3 }
		}},

		{ "id": "sessionmemory", "type": "sessionmemoryagentresource", "docks": {
			"logger": []
		}},
		{ "id": "timememory", "type": "timememoryagentresource" },

		{ "id": "retrieval", "type": "retrievalagenttool", "config": {
			"limit": { "mode": "fixed", "value": 5 },
			"minscore": { "mode": "fixed", "value": 0.4 },
			"collectionkey": { "mode": "fixed", "value": "xrm" }
		}, "docks": {
			"embedding": [ "embed" ],
			"vectorstore": [ "qdrant" ],
			"filters": [ "publicactivefilter" ],
			"logger": []
		}},
		{ "id": "embed", "type": "openaiembeddingmodelagentresource", "config": {
			"apikey": { "mode": "config", "section": "openai", "key": "apikey" },
			"model": { "mode": "fixed", "value": "text-embedding-3-small" }
		}},
		{ "id": "qdrant", "type": "qdrantvectorstoreagentresource", "config": {
			"endpoint": { "mode": "config", "section": "qdrant", "key": "endpoint" },
			"apikey": { "mode": "config", "section": "qdrant", "key": "apikey" }
		}},
		{ "id": "publicactivefilter", "type": "xrmpublicactivevectorfilteragentresource" },

		{ "id": "telegram", "type": "telegramagenttool", "config": {
			"bottoken": { "mode": "config", "section": "telegram", "key": "bottoken" },
			"chatid": { "mode": "config", "section": "telegram", "key": "me" }
		}},

		{ "id": "weather", "type": "weatheragenttool" },
		{ "id": "currency", "type": "currencyconvertagenttool" },
		{ "id": "system", "type": "systemstatusagenttool" },
		{ "id": "webfetch", "type": "webfetchtextagenttool" },
		{ "id": "helloworld", "type": "helloworldcanvasagenttool" },
		{ "id": "canvasclose", "type": "canvascloseagenttool" },
		{ "id": "photomosaicdemo", "type": "photomosaicdemoagenttool" },
		{ "id": "datahawk", "type": "datahawkagenttool" },
		{ "id": "vizion", "type": "vizioncanvasagenttool" },

		{ "id": "log", "type": "loggerresource", "config": {
			"scope": { "mode": "fixed", "value": "Base3ChatWebsite" }
		}},

		{ "id": "profiles", "type": "noopprofileselector" }
	],
	"connections": [
		{ "from": "__input__", "output": "system", "to": "assistant", "input": "system" },
		{ "from": "__input__", "output": "user", "to": "assistant", "input": "prompt" }
	]
}
