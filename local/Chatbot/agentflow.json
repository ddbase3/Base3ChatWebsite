{
	"nodes": [
		{
			"id": "assistant",
			"type": "aiassistantnode",
			"docks": {
				"chatmodel": [ "llm" ],
				"memory": [ "sessionmemory" ],
				"tools": [ "telegram" ]
			}
		}
	],
	"resources": [
		{
			"id": "llm",
			"type": "openaichatmodelagentresource",
			"config": {
				"apikey": { "mode": "config", "section": "openai", "key": "apikey" },
				"model": { "mode": "fixed", "value": "gpt-4o-mini" },
				"temperature": { "mode": "fixed", "value": 0.3 }
			}
		},
		{
			"id": "sessionmemory",
			"type": "sessionmemoryagentresource"
		},
		{
			"id": "telegram",
			"type": "telegramagenttool",
			"config": {
				"bottoken": { "mode": "config", "section": "telegram", "key": "bottoken" },
				"chatid": { "mode": "config", "section": "telegram", "key": "me" }
			}
		}
	],
	"connections": [
		{
			"from": "__input__",
			"output": "system",
			"to": "assistant",
			"input": "system"
		},
		{
			"from": "__input__",
			"output": "user",
			"to": "assistant",
			"input": "prompt"
		}
	]
}
